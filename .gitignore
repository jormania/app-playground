# Dependencies
node_modules/

# Build outputs
dist/
build/
out/
.next/
.turbo/

# Python bytecode cache (scripts/*.py)
__pycache__/
*.pyc

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude Code local config (not needed by the build)
.claude/

# Build info
*.tsbuildinfo
.cache/
.vercel
.env*

# Sensitive scripts
scripts/dramatize-journal.py
scripts/backfill-hltb.py

# Scratch files that keep landing at the repo root (R-001, R-010, R-011 each
# had to sweep them up). Deliberately narrow and root-anchored, so nothing
# real gets swallowed — `scratch_debug.js` is ignored, `src/.../debugger.js`
# is not.
/scratch_*
/debug_*
/*_dump.*
/diff.txt
/lint-output.txt
/patch-*.cjs

# Playwright's default output directory — a `.last-run.json` was tracked here
# for two months because nothing ignored it (R-021).
/test-results/
