{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/generate-law-of-the-day",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/wanderlist-remind",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/wanderlist-remind",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/clickdeck-pricing",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/anthropic-proxy/:match*",
      "destination": "https://api.anthropic.com/:match*"
    }
  ],
  "redirects": [
    {
      "source": "/cabinet.html",
      "destination": "/cabinet-app.html",
      "permanent": true
    }
  ]
}
