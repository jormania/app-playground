{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/*": false
    }
  },
  "crons": [
    { "path": "/api/wanderlist-remind", "schedule": "0 16 * * *" },
    { "path": "/api/wanderlist-remind", "schedule": "0 17 * * *" },
    { "path": "/api/clickdeck-pricing", "schedule": "0 2 * * *" }
  ],
  "rewrites": [
    {
      "source": "/api/clickdeck-hltb",
      "destination": "/api/steam-search?mode=hltb"
    },
    {
      "source": "/api/anthropic-proxy/:match*",
      "destination": "https://api.anthropic.com/:match*"
    }
  ]
}
